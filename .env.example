# ── Веб-интерфейс ─────────────────────────────────────────
HOST=127.0.0.1
PORT=7777
# Пульт открывается по https. По умолчанию мейнфрейм сам поднимает туннель
# Cloudflare (без аккаунта, адрес меняется при перезапуске).
TUNNEL=cloudflared
# Если есть свой постоянный https-адрес, впиши его, туннель не запустится.
# Он же используется для подписки MAX на webhook и для кнопки «Открыть пульт».
PUBLIC_URL=https://mainframe.example.com

# ── MAX (мессенджер MAX, вместо Telegram) ──────────────────
# Токен бота: MAX → Чат-боты → ⋮ → Настройки.
MAX_BOT_TOKEN=
# Твой user_id в MAX. Можно не заполнять: бот привяжется к тебе по коду
# со страницы «Система» (команда /start в MAX).
MAX_OWNER_ID=
# Секрет для webhook: MAX присылает его в заголовке X-Max-Bot-Api-Secret.
# Требования MAX: 5–256 символов из [A-Za-z0-9_-]. Если пусто, мейнфрейм
# сгенерирует свой и положит в data/max-webhook-secret.secret.
MAX_WEBHOOK_SECRET=
# Webhook-endpoint (production). Должен быть https на порту 443, сертификат —
# от доверенного центра или Минцифры. Указывается без порта.
# MAX_WEBHOOK_URL=https://mainframe.example.com/max/webhook
# 1 = получать события опросом GET /updates (только для локальных запусков;
# одновременно с webhook работать нельзя).
MAX_LONG_POLLING=1
# Чаты, где бот отвечает. Пусто = все чаты, где бот состоит.
MAX_ALLOWED_CHATS=
# Чаты, где бот может писать сам (свой канал, чат продаж).
MAX_AUTO_CHATS=

# ── MiniMax (модели, вместо Claude) ───────────────────────
# Ключ: https://platform.minimax.io — международный регион, api.minimax.io.
MINIMAX_API_KEY=
# OpenAI-совместимый эндпоинт.
MINIMAX_BASE_URL=https://api.minimax.io/v1
# Актуальные модели: MiniMax-M3.1-Flash, MiniMax-M3.
MINIMAX_MODEL=MiniMax-M3.1-Flash
# Модель для коротких задач (диспетчер, черновики ответов).
MINIMAX_DISPATCH_MODEL=MiniMax-M3.1-Flash
MINIMAX_MAX_TOKENS=8192
# Сколько шагов с инструментами допускается в одной задаче.
MINIMAX_MAX_TURNS=40
# Глубина размышления модели: low, medium, high, max. Пусто = по умолчанию.
MINIMAX_REASONING_EFFORT=
# Полные права агента. Варианты: bypassPermissions, ask, deny
PERMISSION_MODE=bypassPermissions

# ── Автоматика ───────────────────────────────────────────
# 1 = отправлять правки в сессию и отвечать по базе без подтверждения (если диспетчер уверен).
# Можно включать точечно для отдельных людей на странице «Люди».
AUTO_FORWARD=0
AUTO_REPLY=0

# ── Папки ────────────────────────────────────────────────
# Папка общего проекта «Мейнфрейм» (команды из бота, cron без проекта)
WORKSPACE_DIR=~/Assistant
# База знаний для ответов за тебя
KB_DIR=kb

# Расшифровка голосовых: локальный whisper.cpp (scripts/install-whisper.sh). off = выключить.
WHISPER_URL=http://127.0.0.1:8178
# Язык подсказкой (ru, en). Пусто = определять самому.
WHISPER_LANGUAGE=

# ── Об о владельце (всё личное живёт здесь и в папке памяти, не в коде) ──
OWNER_NAME=
# Одна фраза о себе для постов (что делаешь), остальное агент берёт из памяти
OWNER_ABOUT=
# Канал в MAX для статистики и постов: числовой chat_id, где состоит бот.
SOCIAL_MAX_CHAT_ID=
# Куда ведут посты: адрес продукта (метки utm ставятся сами) и как его называть
OFFER_URL=
OFFER_CTA=ссылка на мой продукт
# Чат продаж в MAX: числовой chat_id, если он присылает заявки и оплаты
SALES_BOT=
# Папка общей памяти внутри WORKSPACE_DIR
MEMORY_DIR_NAME=Память

# ── Сервер и Mac (заполняют install-server.sh и install-mac.sh) ──
# Папки, которые живут на сервере; проекты вне их запускаются на Mac
SERVER_DIRS=
MAC_USER=
MAC_RUNNER=
